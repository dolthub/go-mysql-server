CREATE TABLE `datetime_table` (
  `i` bigint NOT NULL,
  `date_col` date,
  `datetime_col` datetime,
  `timestamp_col` timestamp,
  `time_col` time(6),
  PRIMARY KEY (`i`)
)
----

